{
  "name": "erp-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @erp/web dev",
    "storybook": "pnpm --filter @erp/design-system storybook",
    "build": "pnpm --filter @erp/design-system build && pnpm --filter @erp/web build",
    "build:storybook": "pnpm --filter @erp/design-system build-storybook",
    "preview": "pnpm --filter @erp/web preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html,yaml,yml}\"",
    "test": "pnpm -r --parallel test",
    "clean": "pnpm -r exec rimraf dist node_modules/.vite storybook-static"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^2.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
